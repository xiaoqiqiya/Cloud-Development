# syntax=docker/dockerfile:1
# 可选 Agent 动态层。CI 通过 Bake 的 target:base 直接继承本次选定的 Base。
ARG BASE_IMAGE=ghcr.io/xiaoqiqiya/cloud-development:base-custom
FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-eo", "pipefail", "-c"]
ARG DEBIAN_FRONTEND=noninteractive

# Web IDE 是容器主服务；AI Agent 独立选择，默认仅 Codex。
ARG CODE_SERVER_VERSION=4.115.0
RUN curl -fsSLo /tmp/code-server.deb "https://github.com/coder/code-server/releases/download/v${CODE_SERVER_VERSION}/code-server_${CODE_SERVER_VERSION}_amd64.deb" \
    && apt-get update && apt-get install -y --no-install-recommends /tmp/code-server.deb \
    && rm -f /tmp/code-server.deb && rm -rf /var/lib/apt/lists/*

ARG INSTALL_SERENA=false
ARG SERENA_VERSION=latest
RUN case "$INSTALL_SERENA" in true|false) ;; *) exit 1 ;; esac; \
    if [[ "$INSTALL_SERENA" = true ]]; then \
      UV_CACHE_DIR=/tmp/uv-cache UV_TOOL_BIN_DIR=/usr/local/bin uv tool install -p 3.13 "serena-agent@${SERENA_VERSION}" --prerelease=allow; \
      rm -rf /tmp/uv-cache; serena init; \
    fi

ARG INSTALL_CODEX=true
ARG CODEX_VERSION=latest
RUN case "$INSTALL_CODEX" in true|false) ;; *) exit 1 ;; esac; \
    if [[ "$INSTALL_CODEX" = true ]]; then \
      npm install -g "@openai/codex@${CODEX_VERSION}"; npm cache clean --force; \
    fi

ARG INSTALL_CLAUDE_CODE=false
ARG CLAUDE_CODE_VERSION=latest
RUN case "$INSTALL_CLAUDE_CODE" in true|false) ;; *) exit 1 ;; esac; \
    if [[ "$INSTALL_CLAUDE_CODE" = true ]]; then \
      npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" @cometix/ccline; npm cache clean --force; \
    fi
# 补丁使用 BuildKit 临时挂载，仅在选中 Claude Code 时执行，不带入未选镜像。
RUN --mount=type=bind,source=agent,target=/tmp/agent \
    if [[ "$INSTALL_CLAUDE_CODE" = true ]]; then \
      CCPATCH_DIR=/tmp/agent/ccpatch bash /tmp/agent/run-ccpatch.sh; \
    fi

ARG INSTALL_CODEX_SECURITY=false
ARG CODEX_SECURITY_VERSION=latest
RUN case "$INSTALL_CODEX_SECURITY" in true|false) ;; *) exit 1 ;; esac; \
    if [[ "$INSTALL_CODEX_SECURITY" = true ]]; then \
      npm install -g "@openai/codex-security@${CODEX_SECURITY_VERSION}"; npm cache clean --force; \
    fi

ARG INSTALL_ANTIGRAVITY=false
# 清单只提供当前版本；安装时下载清单，保持原动态层 SHA512 校验。
RUN case "$INSTALL_ANTIGRAVITY" in true|false) ;; *) exit 1 ;; esac; \
    if [[ "$INSTALL_ANTIGRAVITY" = true ]]; then \
      curl -fsSL --retry 10 --retry-all-errors --retry-delay 2 -o /tmp/agy-manifest.json \
        https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/linux_amd64.json; \
      AGY_URL="$(jq -er '.url | strings | select(startswith("https://"))' /tmp/agy-manifest.json)"; \
      AGY_SHA512="$(jq -er '.sha512 | strings | select(test("^[a-fA-F0-9]{128}$"))' /tmp/agy-manifest.json)"; \
      curl -fsSL --retry 10 --retry-all-errors --retry-delay 2 -o /tmp/agy.tar.gz "$AGY_URL"; \
      echo "$AGY_SHA512  /tmp/agy.tar.gz" | sha512sum -c -; \
      tar -xzf /tmp/agy.tar.gz -C /tmp; \
      install -m 0755 /tmp/antigravity /usr/local/bin/agy; \
      rm -f /tmp/agy-manifest.json /tmp/agy.tar.gz /tmp/antigravity; \
    fi

COPY base/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY base/supervisord.conf /etc/supervisor/supervisord.conf
COPY custom-base/healthcheck.sh /usr/local/bin/healthcheck.sh
COPY custom-base/check.py /tmp/check-custom-base.py
RUN chmod +x /usr/local/bin/entrypoint.sh /usr/local/bin/healthcheck.sh \
    && python3 /tmp/check-custom-base.py --agents && rm /tmp/check-custom-base.py
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 CMD ["/usr/local/bin/healthcheck.sh"]
